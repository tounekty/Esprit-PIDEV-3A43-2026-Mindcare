{% extends 'base.html.twig' %}

{% block title %}Modifier la réservation{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h3 class="mb-0">Modifier la Réservation #{{ booking.id }}</h3>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nomEtudiant) }}
                            {{ form_widget(form.nomEtudiant, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.emailEtudiant) }}
                            {{ form_widget(form.emailEtudiant, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.event) }}
                            {{ form_widget(form.event, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                            <a href="{{ path('app_booking_index') }}" class="btn btn-light">Annuler</a>
                        </div>
                        {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
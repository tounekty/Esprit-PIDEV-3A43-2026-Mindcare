{% extends 'base.html.twig' %}

{% block title %}Réserver un atelier{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Formulaire de Réservation</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nomEtudiant) }}
                            {{ form_widget(form.nomEtudiant, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nomEtudiant) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.emailEtudiant) }}
                            {{ form_widget(form.emailEtudiant, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.emailEtudiant) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.event, 'Sélectionner un atelier') }}
                            {{ form_widget(form.event, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.event) }}
                        </div>
                        
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success">Confirmer l'inscription</button>
                            <a href="{{ path('app_booking_index') }}" class="btn btn-light border">Retour</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
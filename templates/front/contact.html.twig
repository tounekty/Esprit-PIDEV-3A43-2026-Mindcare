{% extends "base_front.html.twig" %}

{% block title %}Contact - MoodTracker{% endblock %}
{% block meta_description %}Contactez-nous pour toute question{% endblock %}

{% block content %}
<!-- Breadcrumb -->
<section style="background: linear-gradient(135deg, #009DFF 0%, #0181f5 100%); color: white; padding: 60px 0;">
    <div class="container">
        <h1 style="font-size: 2.5rem; font-weight: 700; margin: 0;">Nous Contacter</h1>
        <p style="font-size: 1.1rem; opacity: 0.9; margin: 10px 0 0 0;">Vos questions sont importantes pour nous</p>
    </div>
</section>

<!-- Contact Info Section -->
<section style="padding: 80px 0; background: white;">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 35px; margin-bottom: 80px;">
            <!-- Phone -->
            <div style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f3ff 100%); padding: 40px; border-radius: 15px; border: 2px solid #d9ebff; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 20px; color: #0181f5;">📞</div>
                <h4 style="color: #131313; font-weight: 700; margin-bottom: 10px;">Téléphone</h4>
                <p style="color: #666; margin: 0; font-size: 15px;">
                    <a href="tel:+33123456789" style="color: #0181f5; text-decoration: none; font-weight: 600;">+33 (0)1 23 45 67 89</a>
                </p>
                <p style="color: #999; font-size: 12px; margin-top: 10px;">Lun - Ven, 9h - 18h</p>
            </div>

            <!-- Email -->
            <div style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f3ff 100%); padding: 40px; border-radius: 15px; border: 2px solid #d9ebff; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 20px; color: #0181f5;">✉️</div>
                <h4 style="color: #131313; font-weight: 700; margin-bottom: 10px;">Email</h4>
                <p style="color: #666; margin: 0; font-size: 15px;">
                    <a href="mailto:info@moodtracker.fr" style="color: #0181f5; text-decoration: none; font-weight: 600;">info@moodtracker.fr</a>
                </p>
                <p style="color: #999; font-size: 12px; margin-top: 10px;">Réponse rapide garantie</p>
            </div>

            <!-- Address -->
            <div style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f3ff 100%); padding: 40px; border-radius: 15px; border: 2px solid #d9ebff; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 20px; color: #0181f5;">📍</div>
                <h4 style="color: #131313; font-weight: 700; margin-bottom: 10px;">Adresse</h4>
                <p style="color: #666; margin: 0; font-size: 15px;">
                    Paris, France
                </p>
                <p style="color: #999; font-size: 12px; margin-top: 10px;">Centre-ville</p>
            </div>
        </div>

        <!-- Contact Form -->
        <div style="background: #f8f9fb; padding: 60px; border-radius: 15px; max-width: 700px; margin: 0 auto;">
            <h2 style="color: #131313; font-size: 1.8rem; font-weight: 700; margin-bottom: 10px; text-align: center;">Envoyez-nous un message</h2>
            <p style="color: #666; text-align: center; margin-bottom: 40px; line-height: 1.7;">
                Nous vous répondrons dans les plus brefs délais
            </p>

            <form method="POST" action="#">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label style="display: block; color: #131313; font-weight: 600; margin-bottom: 10px;">Votre nom</label>
                        <input type="text" placeholder="Jean Dupont" required style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 14px; transition: all .3s ease;">
                    </div>
                    <div>
                        <label style="display: block; color: #131313; font-weight: 600; margin-bottom: 10px;">Votre email</label>
                        <input type="email" placeholder="jean@example.com" required style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 14px; transition: all .3s ease;">
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; color: #131313; font-weight: 600; margin-bottom: 10px;">Sujet</label>
                    <input type="text" placeholder="Mon sujet" required style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 14px; transition: all .3s ease;">
                </div>

                <div style="margin-bottom: 30px;">
                    <label style="display: block; color: #131313; font-weight: 600; margin-bottom: 10px;">Message</label>
                    <textarea placeholder="Votre message..." rows="6" required style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 14px; font-family: inherit; resize: vertical; transition: all .3s ease;"></textarea>
                </div>

                <button type="submit" style="width: 100%; background: linear-gradient(135deg, #0181f5 0%, #5db2ff 100%); color: white; padding: 14px; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; transition: all .3s ease; font-size: 15px;">
                    <i class="fa fa-paper-plane" style="margin-right: 10px;"></i>Envoyer le message
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    input:focus, textarea:focus {
        outline: none;
        border-color: #0181f5 !important;
        box-shadow: 0 0 0 3px rgba(1, 129, 245, 0.1) !important;
    }

    button:hover {
        opacity: 0.95;
    }
</style>
{% endblock %}

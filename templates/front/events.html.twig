{% extends "base_front.html.twig" %}

{% block title %}Événements - MoodTracker{% endblock %}
{% block meta_description %}Découvrez nos événements et webinaires{% endblock %}

{% block content %}
<!-- Breadcrumb -->
<div class="breadcrumb-area" style="background-image: url({{ asset('front_assets/img/banner/breadcrumb.jpg') }})">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="breadcrumb_content">
                    <h1 class="breadcrumb_title">Événements</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Events Section -->
<section class="events-area pt-120 pb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="event-item mb-4">
                    <div class="event-img">
                        <img src="{{ asset('front_assets/img/events/event-1.jpg') }}" alt="">
                    </div>
                    <div class="event-content">
                        <h3>Webinaire: Gestion du Stress</h3>
                        <div class="event-meta">
                            <span><i class="fa fa-calendar"></i> 15 Mars 2026</span>
                            <span><i class="fa fa-clock"></i> 14h00 - 15h30</span>
                        </div>
                        <p>Découvrez les techniques efficaces pour gérer le stress au quotidien.</p>
                        <a href="#" class="btn btn-primary btn-sm">S'inscrire</a>
                    </div>
                </div>

                <div class="event-item mb-4">
                    <div class="event-img">
                        <img src="{{ asset('front_assets/img/events/event-2.jpg') }}" alt="">
                    </div>
                    <div class="event-content">
                        <h3>Atelier: Méditation et Pleine Conscience</h3>
                        <div class="event-meta">
                            <span><i class="fa fa-calendar"></i> 22 Mars 2026</span>
                            <span><i class="fa fa-clock"></i> 18h00 - 19h30</span>
                        </div>
                        <p>Apprenez les bases de la méditation pour améliorer votre bien-être.</p>
                        <a href="#" class="btn btn-primary btn-sm">S'inscrire</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar">
                    <h4>Événements à Venir</h4>
                    <ul class="event-list">
                        <li><span class="date">15/03</span> Gestion du Stress</li>
                        <li><span class="date">22/03</span> Méditation</li>
                        <li><span class="date">29/03</span> Dépression et Anxiété</li>
                        <li><span class="date">05/04</span> Sommeil et Santé Mentale</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

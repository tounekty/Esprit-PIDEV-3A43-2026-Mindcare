{% extends "base_front.html.twig" %}

{% block title %}Mon Tableau de Bord - MoodTracker{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Entrées ce Mois</h5>
                    <h2>24</h2>
                    <small class="text-muted">Vous progressez bien!</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Humeur Moyenne</h5>
                    <h2>😊</h2>
                    <small class="text-muted">Positive</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Séance Suivante</h5>
                    <h3>15 Mars</h3>
                    <small class="text-muted">avec Dr. Dupont</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Profil</h5>
                    <a href="#" class="btn btn-sm btn-primary">Voir Plus</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Entrées Récentes</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>10 Mars - Heureux 😊</strong>
                                <small>Bonne journée au travail</small>
                            </div>
                        </div>
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>09 Mars - Neutre 😐</strong>
                                <small>Journée normale</small>
                            </div>
                        </div>
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>08 Mars - Stressé 😰</strong>
                                <small>Réunion importante</small>
                            </div>
                        </div>
                    </div>
                    <a href="#" class="btn btn-primary btn-sm mt-3">Voir l'historique</a>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Prochaines Actions</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <strong>📝 Ajouter une humeur</strong>
                                    <p class="mb-0 text-muted small">Comment vous vous sentez aujourd'hui?</p>
                                </div>
                                <a href="{{ path('app_mood_new') }}" class="btn btn-sm btn-primary">Ajouter</a>
                            </div>
                        </li>
                        <li class="mb-3">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <strong>📊 Voir vos humeurs</strong>
                                    <p class="mb-0 text-muted small">Analyse de votre bien-être</p>
                                </div>
                                <a href="{{ path('app_mood_index') }}" class="btn btn-sm btn-primary">Voir</a>
                            </div>
                        </li>
                        <li>
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <strong>📔 Journal émotionnel</strong>
                                    <p class="mb-0 text-muted small">Vos entrées et notes</p>
                                </div>
                                <a href="{{ path('app_journal_emotionnel_index') }}" class="btn btn-sm btn-primary">Accéder</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

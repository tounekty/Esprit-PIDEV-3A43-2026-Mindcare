{% extends 'base.html.twig' %}

{% block title %}Forum{% endblock %}

{% block body %}
    <style>
        .forum-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 80px 0;
            color: white;
            text-align: center;
        }
        .forum-topic-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            margin-bottom: 30px;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .forum-topic-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
        }
        .topic-image-wrapper {
            width: 100%;
            height: 220px;
            overflow: hidden;
            position: relative;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }
        .topic-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }
        .forum-topic-card:hover .topic-image {
            transform: scale(1.1);
        }
        .topic-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 64px;
            color: rgba(102, 126, 234, 0.3);
        }
        .topic-badges {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .topic-badge {
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 600;
            backdrop-filter: blur(10px);
        }
        .badge-pinned {
            background: rgba(255, 193, 7, 0.9);
            color: #fff;
        }
        .badge-category {
            background: rgba(102, 126, 234, 0.9);
            color: #fff;
        }
        .topic-content {
            padding: 25px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .topic-title {
            font-size: 22px;
            font-weight: bold;
            color: #333;
            margin-bottom: 12px;
            line-height: 1.4;
        }
        .topic-description {
            color: #666;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 20px;
            flex: 1;
        }
        .topic-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 15px;
            border-top: 2px solid #f0f0f0;
            font-size: 13px;
            color: #999;
        }
        .topic-date {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .view-topic-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 10px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }
        .view-topic-btn:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }
        .create-topic-btn {
            background: white;
            color: #667eea;
            padding: 16px 40px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: all 0.3s;
        }
        .create-topic-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            color: #667eea;
        }
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }
        .empty-state-icon {
            font-size: 80px;
            color: #e0e0e0;
            margin-bottom: 20px;
        }
        .forum-filter-bar {
            background: white;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            padding: 20px;
            margin-top: -50px;
            position: relative;
            z-index: 2;
        }
        .forum-filter-bar input,
        .forum-filter-bar select {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 14px;
        }
        .forum-filter-bar button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            font-weight: 600;
        }
    </style>

    <div class="forum-header">
        <div class="container">
            <h1 style="font-size: 48px; font-weight: bold; margin-bottom: 15px;">
                <i class="ti-comments" style="margin-right: 15px;"></i>Forum de Discussion
            </h1>
            <p style="font-size: 18px; opacity: 0.9; max-width: 600px; margin: 0 auto 30px;">
                Partagez vos questions, experiences et conseils avec notre communaute
            </p>
            <a href="{{ path('front_forum_new') }}" class="create-topic-btn">
                <i class="ti-plus"></i>
                Creer un nouveau sujet
            </a>
        </div>
    </div>

    <div class="container" style="padding: 80px 0;">
        <div class="forum-filter-bar">
            <form method="get" action="{{ path('front_forum_index') }}" class="row g-3">
                <div class="col-md-5">
                    <input type="text" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Rechercher un sujet...">
                </div>
                <div class="col-md-4">
                    <select name="category" class="form-select">
                        <option value="">Toutes les categories</option>
                        {% for label, value in categories|default([]) %}
                            <option value="{{ value }}" {% if category|default('') == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="w-100">Filtrer</button>
                </div>
            </form>
        </div>

        <div class="row mt-5">
            {% if sujets is defined and sujets|length > 0 %}
                {% for sujet in sujets %}
                    <div class="col-lg-4 col-md-6">
                        <div class="forum-topic-card">
                            <div class="topic-image-wrapper">
                                {% if sujet.imageUrl %}
                                    <img src="{{ sujet.imageUrl }}" class="topic-image" alt="topic">
                                {% else %}
                                    <div class="topic-icon"><i class="ti-image"></i></div>
                                {% endif %}
                                <div class="topic-badges">
                                    {% if sujet.isPinned %}
                                        <span class="topic-badge badge-pinned">Epingle</span>
                                    {% endif %}
                                    {% if sujet.category %}
                                        <span class="topic-badge badge-category">{{ sujet.category }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="topic-content">
                                <div class="topic-title">{{ sujet.titre }}</div>
                                <div class="topic-description">{{ sujet.description|slice(0, 120) ~ '...' }}</div>
                                <div class="topic-meta">
                                    <div class="topic-date"><i class="ti-time"></i>{{ sujet.dateCreation|date('d/m/Y') }}</div>
                                    <a href="{{ path('front_forum_show', {id: sujet.id}) }}" class="view-topic-btn">
                                        Voir
                                        <i class="ti-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="empty-state">
                        <div class="empty-state-icon">😶</div>
                        <h3>Aucun sujet pour le moment</h3>
                        <p class="text-muted">Soyez le premier a lancer une discussion.</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

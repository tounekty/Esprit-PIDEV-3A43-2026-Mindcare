{% extends 'base.html.twig' %}

{% block title %}Journal Émotionnel | MindCare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, #7FBFFF 0%, #A8D8FF 100%);
            color: white;
            padding: 2.5rem;
            border-radius: 15px;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(127, 191, 255, 0.2);
        }
        
        .page-header h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .page-header p {
            opacity: 0.95;
            margin: 0;
        }
        
        /* Stats Grid */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .stat-card {
            background: white;
            border: 1px solid #D4E8FF;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 12px rgba(127, 191, 255, 0.15);
            transition: all 0.3s;
        }
        
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(127, 191, 255, 0.2);
        }
        
        .stat-label {
            font-size: 0.85rem;
            color: #718096;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
            margin-bottom: 0.5rem;
        }
        
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #7FBFFF;
        }
        
        /* Cards */
        .card-modern {
            background: white;
            border: 1px solid #D4E8FF;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(127, 191, 255, 0.15);
            transition: all 0.3s;
            overflow: hidden;
            height: 100%;
        }
        
        .card-modern:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(127, 191, 255, 0.25);
        }
        
        .card-modern-header {
            background: linear-gradient(135deg, rgba(127, 191, 255, 0.1) 0%, rgba(168, 216, 255, 0.1) 100%);
            border-bottom: 1px solid #D4E8FF;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .card-modern-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
        }
        
        .card-title {
            color: #1a365d;
            font-weight: 700;
            font-size: 1.1rem;
            margin: 0;
        }
        
        .card-subtitle {
            color: #718096;
            font-size: 0.85rem;
            display: block;
            margin-top: 0.5rem;
        }
        
        .card-text {
            color: #4A5568;
            line-height: 1.6;
            flex-grow: 1;
        }
        
        .text-muted {
            color: #718096 !important;
            font-size: 0.9rem;
        }
        
        /* Journal Grid */
        .journal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }
        
        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, #7FBFFF 0%, #A8D8FF 100%) !important;
            border: none !important;
            color: #1a365d !important;
            font-weight: 600 !important;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(127, 191, 255, 0.3) !important;
        }
        
        .btn-light {
            background: white !important;
            color: #1a365d !important;
            border-color: white !important;
            font-weight: 600 !important;
        }
        
        .btn-light:hover {
            background: #F0F7FF !important;
            color: #1a365d !important;
        }
        
        .btn-outline-secondary {
            color: #7FBFFF !important;
            border-color: #D4E8FF !important;
        }
        
        .btn-outline-secondary:hover {
            background-color: #E8F0FF !important;
            border-color: #A8D8FF !important;
        }
        
        .btn-outline-danger {
            color: #e53e3e !important;
            border-color: #feb2b2 !important;
        }
        
        .btn-outline-danger:hover {
            background-color: #fff5f5 !important;
            border-color: #f56565 !important;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
        }
        
        .empty-state i {
            font-size: 3rem;
            color: #CBD5E0;
            margin-bottom: 1rem;
            display: block;
        }
        
        .empty-state h3 {
            color: #1a365d;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .empty-state p {
            color: #718096;
            margin-bottom: 1.5rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="mb-1">
                    <i class="fas fa-book me-2"></i>Journal Émotionnel
                </h1>
                <p>Exprimez vos pensées et vos émotions</p>
            </div>
            <div class="col-auto d-flex gap-2">
                <a href="{{ path('app_mood_index') }}" class="btn btn-light btn-lg">
                    <i class="fas fa-heartbeat me-1"></i> Humeurs
                </a>
                <a href="{{ path('app_journal_emotionnel_index') }}" class="btn btn-light btn-lg">
                    <i class="fas fa-plus me-1"></i> Nouvelle Entrée
                </a>
            </div>
        </div>
        
        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <span class="stat-label"><i class="fas fa-list me-1"></i>Total Entrées</span>
                <span class="stat-value">{{ journal_emotionnels|length }}</span>
            </div>
            <div class="stat-card">
                <span class="stat-label"><i class="fas fa-file-alt me-1"></i>Mots Totaux</span>
                <span class="stat-value">
                    {% set word_count = 0 %}
                    {% for entry in journal_emotionnels %}
                        {% set word_count = word_count + (entry.contenu|split(' ')|length) %}
                    {% endfor %}
                    {{ word_count }}
                </span>
            </div>
            <div class="stat-card">
                <span class="stat-label"><i class="fas fa-clock me-1"></i>Dernière Entrée</span>
                <span class="stat-value">
                    {% if journal_emotionnels|length > 0 %}
                        {% set last_date = journal_emotionnels[0].dateecriture %}
                        {% set now = "now"|date('U') %}
                        {% set diff = (now - last_date|date('U')) %}
                        {% if diff < 86400 %}
                            Aujourd'hui
                        {% elseif diff < 172800 %}
                            Hier
                        {% else %}
                            {{ (diff / 86400)|round }}j
                        {% endif %}
                    {% else %}
                        -
                    {% endif %}
                </span>
            </div>
        </div>
    </div>

    <!-- Journal Entries List -->
    {% if journal_emotionnels|length > 0 %}
        <div class="journal-grid">
            {% for entry in journal_emotionnels %}
            <div class="card-modern">
                <div class="card-modern-header">
                    <div>
                        <h5 class="card-title">Entrée #{{ entry.id }}</h5>
                        <span class="card-subtitle">
                            <i class="far fa-calendar me-1"></i>
                            {{ entry.dateecriture|date('d/m/Y à H:i') }}
                        </span>
                    </div>
                </div>
                
                <div class="card-modern-body">
                    <!-- Mood Badge -->
                    {% if entry.mood %}
                    <div class="mb-3">
                        <span class="badge bg-info" style="font-size: 1.2rem; padding: 0.5rem 1rem;">
                            {% if entry.mood.humeur == 'heureux' %} 😊 Heureux
                            {% elseif entry.mood.humeur == 'triste' %} 😢 Triste
                            {% elseif entry.mood.humeur == 'colere' %} 😠 En colère
                            {% elseif entry.mood.humeur == 'stresse' %} 😰 Stressé
                            {% else %} 😐 Neutre
                            {% endif %}
                        </span>
                    </div>
                    {% endif %}
                    
                    <!-- Content Preview -->
                    <p class="card-text mb-3">
                        {% if entry.contenu|length > 150 %}
                            {{ entry.contenu|slice(0, 150) }}...
                        {% else %}
                            {{ entry.contenu }}
                        {% endif %}
                    </p>
                    
                    <!-- Statistics -->
                    <small class="text-muted d-block mb-3">
                        <i class="fas fa-pencil me-1" style="color: #7FBFFF;"></i>
                        {{ (entry.contenu|split(' ')|length) }} mots
                    </small>
                    
                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-auto">
                        <a href="{{ path('app_journal_emotionnel_show', {'id': entry.id}) }}" class="btn btn-sm btn-primary flex-grow-1">
                            <i class="fas fa-eye me-1"></i> Lire
                        </a>
                        <a href="{{ path('app_journal_emotionnel_edit', {'id': entry.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-edit me-1"></i> Modifier
                        </a>
                        <form method="post" action="{{ path('app_journal_emotionnel_delete', {'id': entry.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer cette entrée ?')">
                                <i class="fas fa-trash me-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Empty State -->
        <div class="card-modern">
            <div class="card-modern-body">
                <div class="empty-state">
                    <i class="fas fa-feather"></i>
                    <h3>Aucune entrée de journal</h3>
                    <p>Commencez à écrire vos pensées et émotions maintenant!</p>
                    <a href="{{ path('app_journal_emotionnel_new') }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus me-1"></i> Créer une Entrée
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
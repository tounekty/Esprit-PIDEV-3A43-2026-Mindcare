<form method="post" action="{{ path('app_journal_delete', {'id': journal_emotionnel.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ journal_emotionnel.id) }}">
    <button class="btn btn-outline-danger btn-sm" style="color: #F56565 !important; border-color: #F56565 !important; font-weight: 600;">
        <i class="fas fa-trash me-1"></i> Supprimer
    </button>
</form>

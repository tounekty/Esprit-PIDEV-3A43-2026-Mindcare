{% extends 'admin/base_admin.html.twig' %}

{% block title %}Sujets Forum{% endblock %}
{% block page_title %}Sujets Forum{% endblock %}

{% block body %}
<div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <small class="text-muted d-block mb-1">Total</small>
                <h4 id="statTotal" class="mb-0">{{ stats.total }}</h4>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <small class="text-muted d-block mb-1">Epingles</small>
                <h4 id="statPinned" class="mb-0">{{ stats.pinned }}</h4>
            </div>
        </div>
    </div>
    {% for label, value in statusChoices %}
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <small class="text-muted d-block mb-1">{{ label|split(' -> ')|first }}</small>
                    <h4 class="mb-0" id="statStatus{{ value }}">{{ stats.byStatus[value] ?? 0 }}</h4>
                </div>
            </div>
        </div>
    {% endfor %}
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <small class="text-muted d-block mb-1">Resultats affiches</small>
                <h4 id="statVisible" class="mb-0">{{ visible_count }}</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">Liste des sujets</h5>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('sujet_forum_new') }}" class="btn btn-primary btn-sm text-uppercase fw-semibold px-3 toolbar-btn">Nouveau sujet</a>
            <a href="{{ path('message_forum_index') }}" class="btn btn-outline-secondary btn-sm text-uppercase fw-semibold px-3 toolbar-btn">Voir messages</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-lg-5">
                <input
                    id="sujetSearch"
                    type="text"
                    class="form-control"
                    placeholder="Rechercher par titre ou description..."
                    value="{{ filters.query }}"
                >
            </div>
            <div class="col-lg-3">
                <select id="sujetStatusFilter" class="form-select">
                    <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>Tous les statuts</option>
                    {% for label, value in statusChoices %}
                        <option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-lg-3">
                {% set currentSort = filters.sort ~ '_' ~ filters.direction|lower %}
                <select id="sujetSort" class="form-select">
                    <option value="date_desc" {{ currentSort == 'date_desc' ? 'selected' : '' }}>Plus recents</option>
                    <option value="date_asc" {{ currentSort == 'date_asc' ? 'selected' : '' }}>Plus anciens</option>
                    <option value="title_asc" {{ currentSort == 'title_asc' ? 'selected' : '' }}>Titre A-Z</option>
                    <option value="title_desc" {{ currentSort == 'title_desc' ? 'selected' : '' }}>Titre Z-A</option>
                    <option value="status_asc" {{ currentSort == 'status_asc' ? 'selected' : '' }}>Statut A-Z</option>
                    <option value="status_desc" {{ currentSort == 'status_desc' ? 'selected' : '' }}>Statut Z-A</option>
                </select>
            </div>
            <div class="col-lg-1 d-grid">
                <button id="sujetReset" type="button" class="btn btn-light toolbar-btn">Reset</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>User</th>
                        <th>Image</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="sujetsTableBody">
                    {% include 'forum/sujet/_rows.html.twig' with {rows: rows} %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
.toolbar-btn {
    min-width: 110px;
    border-radius: 6px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('sujetSearch');
    const statusFilter = document.getElementById('sujetStatusFilter');
    const sortSelect = document.getElementById('sujetSort');
    const resetBtn = document.getElementById('sujetReset');
    const tableBody = document.getElementById('sujetsTableBody');
    const ajaxUrl = '{{ path('sujet_forum_ajax') }}';

    let debounceTimer;

    const updateStats = (stats, visibleCount) => {
        const set = (id, value) => {
            const el = document.getElementById(id);
            if (el) {
                el.textContent = value;
            }
        };

        set('statTotal', stats.total ?? 0);
        set('statPinned', stats.pinned ?? 0);
        if (stats.byStatus) {
            Object.keys(stats.byStatus).forEach((key) => {
                set(`statStatus${key}`, stats.byStatus[key]);
            });
        }
        set('statVisible', visibleCount ?? 0);
    };

    const loadSujets = async () => {
        if (!tableBody) {
            return;
        }

        const [sort, direction] = (sortSelect.value || 'date_desc').split('_');

        const params = new URLSearchParams({
            q: searchInput.value.trim(),
            status: statusFilter.value,
            sort: sort,
            direction: (direction || 'desc').toUpperCase(),
        });

        tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-4">Chargement...</td></tr>';

        try {
            const response = await fetch(`${ajaxUrl}?${params.toString()}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
            });

            if (!response.ok) {
                throw new Error('Erreur de chargement');
            }

            const data = await response.json();
            tableBody.innerHTML = data.rowsHtml;
            updateStats(data.stats || {}, data.visibleCount || 0);
        } catch (error) {
            tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Impossible de charger les donnees.</td></tr>';
        }
    };

    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadSujets, 300);
    });

    statusFilter.addEventListener('change', loadSujets);
    sortSelect.addEventListener('change', loadSujets);

    resetBtn.addEventListener('click', function () {
        searchInput.value = '';
        statusFilter.value = 'all';
        sortSelect.value = 'date_desc';
        loadSujets();
    });
});
</script>
{% endblock %}

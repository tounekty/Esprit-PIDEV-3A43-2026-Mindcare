{% extends 'admin/base_admin.html.twig' %}

{% block title %}Sujets Forum{% endblock %}
{% block page_title %}Sujets Forum{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Liste des sujets</h5>
                    <div class="card-header-action">
                        <a href="{{ path('sujet_forum_new') }}" class="btn btn-primary">Nouveau sujet</a>
                        <a href="{{ path('message_forum_index') }}" class="btn btn-secondary ms-2">Voir messages</a>
                    </div>
                </div>
                <div class="card-body custom-card-action">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Image</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for sujet in sujets %}
                                <tr>
                                    <td>
                                        {{ sujet.titre }}
                                        {% if sujet.isPinned %}<span class="badge bg-warning ms-1">📌</span>{% endif %}
                                    </td>
                                    <td>{{ sujet.description|slice(0, 50) }}...</td>
                                    <td>{{ sujet.dateCreation|date('Y-m-d H:i') }}</td>
                                    <td>{{ sujet.idUser }}</td>
                                    <td>
                                        {% if sujet.imageUrl %}
                                            <img src="{{ sujet.imageUrl }}" alt="img" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if sujet.status %}
                                            <span class="badge bg-info">{{ sujet.status }}</span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="dropdown">
                                            <a href="#" class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="feather-more-vertical"></i>
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="{{ path('sujet_forum_show', {id: sujet.id}) }}"><i class="feather-eye me-2"></i> Voir</a></li>
                                                <li><a class="dropdown-item" href="{{ path('sujet_forum_edit', {id: sujet.id}) }}"><i class="feather-edit me-2"></i> Modifier</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucun sujet.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau sujet{% endblock %}
{% block page_title %}Nouveau sujet{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    {{ form_start(form) }}
                        {{ form_row(form.titre) }}
                        {{ form_row(form.description) }}
                        {{ form_row(form.idUser) }}
                        {{ form_row(form.imageFile) }}
                        {{ form_row(form.isPinned) }}
                        {{ form_row(form.status) }}
                        {{ form_row(form.category) }}
                        {{ form_row(form.attachmentFile) }}
                        
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                            <a href="{{ path('sujet_forum_index') }}" class="btn btn-secondary ms-2">Retour</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

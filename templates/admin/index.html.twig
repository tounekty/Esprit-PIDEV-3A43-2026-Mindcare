{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block page_title %}User Management Dashboard{% endblock %}

{% block body %}
    <div class="row">
        {# Total Users Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-primary bg-opacity-10">
                                <i class="feather-users"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.totalUsers }}</div>
                                <h3 class="fs-13 fw-semibold">Total Users</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Verified Users Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-success bg-opacity-10">
                                <i class="feather-check-circle"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.verifiedUsers }}</div>
                                <h3 class="fs-13 fw-semibold">Verified Users</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Unverified Users Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-warning bg-opacity-10">
                                <i class="feather-alert-circle"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.unverifiedUsers }}</div>
                                <h3 class="fs-13 fw-semibold">Unverified Users</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        {# Psychologists Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-info bg-opacity-10">
                                <i class="feather-briefcase"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.totalPsychologists }}</div>
                                <h3 class="fs-13 fw-semibold">Psychologists</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Students Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-secondary bg-opacity-10">
                                <i class="feather-book"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.totalStudents }}</div>
                                <h3 class="fs-13 fw-semibold">Students</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Banned Users Card #}
        <div class="col-xxl-4 col-md-6">
            <div class="card stretch stretch-full">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-4">
                        <div class="d-flex gap-4 align-items-center">
                            <div class="avatar-text avatar-lg bg-danger bg-opacity-10">
                                <i class="feather-lock"></i>
                            </div>
                            <div>
                                <div class="fs-4 fw-bold text-dark">{{ statistics.bannedUsers }}</div>
                                <h3 class="fs-13 fw-semibold">Banned Users</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

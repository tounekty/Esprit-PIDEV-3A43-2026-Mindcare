{% extends 'base.html.twig' %}

{% block body %}
<div class="wrapper">
  <div class="title-text">
    <div class="title login">Login Form</div>
    <div class="title signup">Signup Form</div>
  </div>
  <div class="form-container">
    <div class="slide-controls">
      <input type="radio" name="slide" id="login" checked>
      <input type="radio" name="slide" id="signup">
      <label for="login" class="slide login">Login</label>
      <label for="signup" class="slide signup">Signup</label>
      <div class="slider-tab"></div>
    </div>

    <div class="form-inner">
      <!-- LOGIN FORM -->
      <form method="post"
            action="{{ path('app_login') }}"
            class="login"
            autocomplete="off">

        {% if error %}
          <div style="color:red; margin-bottom:10px;">
              {{ error.messageKey|trans(error.messageData, 'security') }}
          </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div style="color:red; margin-bottom:10px;">{{ message }}</div>
        {% endfor %}

        <div class="field">
            <input type="email"
                   name="email"
                   placeholder="Email Address"
                   value="{{ last_username }}"
                   required
                   autocomplete="off">
        </div>

        <div class="field">
            <input type="password"
                   name="password"
                   placeholder="Password"
                   required
                   autocomplete="new-password">
        </div>

        <!-- CAPTCHA -->
        <div class="field">
            <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
        </div>

        <!-- CSRF TOKEN -->
        <input type="hidden"
               name="_csrf_token"
               value="{{ csrf_token('authenticate') }}">

        <div class="field btn">
            <div class="btn-layer"></div>
            <input type="submit" value="Login">
        </div>
      </form>

      <!-- SIGNUP FORM -->
      <form method="POST"
            action="{{ path('app_register') }}"
            class="signup"
            autocomplete="off">

        {% for message in app.flashes('error') %}
          <div style="color:red; margin-bottom:10px;">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
          <div style="color:green; margin-bottom:10px;">{{ message }}</div>
        {% endfor %}

        <div class="field">
          <input type="text" name="firstName" placeholder="First Name" required autocomplete="off">
        </div>
        <div class="field">
          <input type="text" name="lastName" placeholder="Last Name" required autocomplete="off">
        </div>
        <div class="field">
          <input type="email" name="email" placeholder="Email Address" required autocomplete="off">
        </div>
        <div class="field">
          <input type="password" name="password" placeholder="Password" required autocomplete="new-password">
        </div>
        <div class="field">
          <input type="password" name="confirmPassword" placeholder="Confirm Password" required autocomplete="new-password">
        </div>

        <div class="field btn">
          <div class="btn-layer"></div>
          <input type="submit" value="Signup">
        </div>
      </form>
    </div>
  </div>
</div>

{# Banned Popup #}
{% if banned_until %}
  <div id="banned-popup" class="banned-popup">
      <h3>⚠️ Compte banni !</h3>
      <p>Votre compte est banni jusqu'au <strong>{{ banned_until }}</strong>.</p>
      <button id="close-banned-popup">Fermer</button>
  </div>

  <style>
      .banned-popup {
          position: fixed;
          top: 20px;
          right: 20px;
          background-color: #f8d7da;
          color: #721c24;
          border: 1px solid #f5c6cb;
          border-radius: 8px;
          padding: 15px 20px;
          z-index: 9999;
          box-shadow: 0 4px 8px rgba(0,0,0,0.2);
          animation: slideIn 0.5s ease forwards;
          max-width: 300px;
      }
      .banned-popup h3 { margin: 0 0 5px 0; font-size: 16px; }
      .banned-popup p { margin: 0 0 10px 0; font-size: 14px; }
      .banned-popup button {
          background-color: #721c24;
          color: white;
          border: none;
          padding: 5px 10px;
          border-radius: 5px;
          cursor: pointer;
      }
      @keyframes slideIn {
          from { opacity: 0; transform: translateX(100%); }
          to { opacity: 1; transform: translateX(0); }
      }
      .banned-popup.fade-out { animation: fadeOut 0.5s forwards; }
      @keyframes fadeOut {
          from { opacity: 1; transform: translateX(0); }
          to { opacity: 0; transform: translateX(100%); }
      }
  </style>

  <script>
      document.addEventListener('DOMContentLoaded', () => {
          const popup = document.getElementById('banned-popup');
          const closeBtn = document.getElementById('close-banned-popup');
          if (popup && closeBtn) {
              const hidePopup = () => {
                  popup.classList.add('fade-out');
                  setTimeout(() => popup.style.display = 'none', 500);
              };
              closeBtn.addEventListener('click', hidePopup);
              setTimeout(hidePopup, 10000); // auto-hide after 10 seconds
          }
      });
  </script>
{% endif %}

<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}
